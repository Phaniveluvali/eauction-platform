  let cleanedUrl = url.replace(/\/!ut\/p\/.*$/, '');
  const temp = new URL(cleanedUrl);
  const cleanedPath = temp.pathname.replace(/^\/myportal/, '');
  const finalUrl = cleanedPath + temp.search + temp.hash;
  if (finalUrl !== window.location.pathname + window.location.search + window.location.hash) {
    window.history.replaceState({}, document.title, finalUrl);
  }

  const isLoggedIn = !!(typeof userC !== "undefined" && userC.length > 0 && userC !== "[]");
  let storedLang = localStorage.getItem("portalLang");

  if (isLoggedIn) {
    if (!storedLang) {
      storedLang = (typeof window.preLanguage !== "undefined" && window.preLanguage.length > 0) ? window.preLanguage : "en";
      localStorage.setItem("portalLang", storedLang);
    }
  } else {
    localStorage.removeItem("portalLang");
    storedLang = document.documentElement.lang || "en";
  }

  window.applyLanguage = (targetLang, persist) => {
    const activeLang = document.documentElement.lang || "en";
    if (activeLang.toLocaleLowerCase() !== targetLang.toLocaleLowerCase()) {
      const langLink = document.querySelector("#language-link");
      if (langLink) {
        if (persist) localStorage.setItem("portalLang", targetLang);
        window.location.href = langLink.href;
      }
    }
  };

  window.applyLanguage(storedLang, isLoggedIn);

  const langLink = document.querySelector("#language-link");
  if (langLink) {
    langLink.addEventListener("click", (e) => {
      e.preventDefault();
      const newLang = (document.documentElement.lang || "en") === "en" ? "ar" : "en";
      if (isLoggedIn) localStorage.setItem("portalLang", newLang);
      window.location.href = e.currentTarget.href;
    });
  }

  const currentUrl1 = new URL(window.location.href);
  const segments = currentUrl1.pathname.split("/").filter(Boolean);
  const currentLang = 
    segments[0] === "en" || segments[0] === "ar" ? segments[0] :
    segments[0] === "myportal" && (segments[1] === "en" || segments[1] === "ar") ? segments[1] :
    null;

  if (currentLang) {
    window.injectLang = (link) => {
      try {
        const href = link.getAttribute("href");
        if (!href || href.startsWith("javascript:") || href.startsWith("#")) return;

        const url = href.startsWith("http") ? new URL(href) : new URL(href, currentUrl1.origin);
        if (url.hostname !== currentUrl1.hostname) return;

        const parts = url.pathname.split("/").filter(Boolean);
        if (url.pathname.startsWith("/dx/api/dam")) {
            return;
        }
        if (parts[0] === "en" || parts[0] === "ar" ||
            (parts[0] === "myportal" && (parts[1] === "en" || parts[1] === "ar"))) return;

        if (!parts.length) parts.push(currentLang);
        else if (parts[0] === "myportal") parts.splice(1, 0, currentLang);
        else parts.unshift(currentLang);

        url.pathname = "/" + parts.join("/");
        link.href = url.toString();
      } catch {}
    };

    window.processLinks = () => document.querySelectorAll("a[href]").forEach(window.injectLang);
    window.processLinks();

    new MutationObserver(mutations => {
      mutations.forEach(m => m.addedNodes.forEach(node => {
        if (node.nodeType === Node.ELEMENT_NODE) {
          node.tagName === "A" ? window.injectLang(node) : node.querySelectorAll("a[href]").forEach(window.injectLang);
        }
      }));
    }).observe(document.body, { childList: true, subtree: true });
  }
