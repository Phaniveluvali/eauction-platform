  /* UNIQUE PREFIX: lc-chat- */
.lc-chat-wrapper *{
  box-sizing:border-box;
  margin:0;
  padding:0;
  font-family: Inter, sans-serif;
}

/* FLOAT BUTTON */
.lc-chat-toggle{
  position:fixed;
  right:20px;
  bottom:20px;
  width:56px;height:56px;
  border-radius:50%;
  background:#2E7D4F;
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  font-size:22px;
  z-index:9999;
}

/* MAIN BOX */
.lc-chat-box{
  position:fixed;
  right:20px;
  bottom:90px;
  width:360px;
  height:520px;
  background:#fff;
  border-radius:24px;
  overflow:hidden;
  display:none;
  box-shadow:0 12px 30px rgba(0,0,0,0.2);
  z-index:9999;
}

/* SCREENS */
.lc-chat-screen{display:none;height:100%;}
.lc-chat-active{display:block;}

/* HEADER */
.lc-chat-header{
  background:#2E7D4F;
  color:#fff;
  padding:20px 16px 20px;
  font-size:15px;
  font-weight:600;
  display:flex;
  align-items:center;
  gap:5px;
}

.lc-chat-back{
  cursor:pointer;
  font-size:18px;
}

/* TOP AREA */
.lc-chat-top{
  background:#2E7D4F;
  padding:1px 16px 16px;
}

/* SEARCH */
.lc-chat-search{
  background:#fff;
  border-radius:24px;
  padding:8px 12px;
  display:flex;
  align-items:center;
  margin-top:8px;
}

.lc-chat-search input{
  border:none;
  outline:none;
  flex:1;
  font-size:13px;
}

.lc-chat-small-avatar{
  width:26px;height:26px;
  border-radius:50%;
  background:#2E7D4F;
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:12px;
}

/* BUTTON */
.lc-chat-add{
  margin-top:12px;
  text-align:center;
}

.lc-chat-add button{
  border:1px solid #fff;
  background:transparent;
  color:#fff;
  padding:6px 16px;
  border-radius:20px;
  font-size:12px;
  cursor: pointer;
}

/* LIST */
.lc-chat-list{
  padding:16px;
  height:calc(100% - 140px);
  overflow-y:auto;
}

.lc-chat-item{
  display:flex;
  align-items:flex-start;
  gap:10px;
  padding:12px 0;
  border-bottom:1px solid #CFC3E6;
  cursor:pointer;
}

.lc-chat-avatar{
  width:34px;height:34px;
  border-radius:50%;
  background:#2E7D4F;
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:13px;
}

.lc-chat-title{
  font-size:14px;
  font-weight:600;
}

.lc-chat-desc{
  font-size:12px;
  color:#777;
  margin-top: 8px;
}

.lc-chat-meta{
  margin-left:auto;
  text-align: -webkit-right !important;
}

.lc-chat-time{
  font-size:10px;
  color:#888;
}

.lc-chat-badge{
  margin-top:4px;
  background:#2E7D4F;
  color:#fff;
  font-size:10px;
  padding:2px 6px;
  border-radius:6px;
  width: max-content;
}

.lc-chat-body{
  padding:16px;
  height:75%;
  overflow-y:auto;
  background:#F5F5F5;
}

.lc-chat-row{
  display:flex;
  gap:8px;
  margin-bottom:12px;
}

.lc-chat-msg{
  padding:10px 14px;
  border-radius:18px;
  font-size:12px;
  max-width:70%;
  word-wrap: break-word;
  overflow-wrap: break-word;
  white-space: normal;
}

.lc-chat-left{background:#E6DCFA;}
.lc-chat-right{
  background:#CFAFFF;
  margin-left:auto;
}

/* INPUT */
.lc-chat-input{
  position:absolute;
  bottom:12px;
  left:12px;
  right:12px;
  background:#fff;
  border-radius:28px;
  padding:8px 10px;
  display:flex;
  align-items:center;
  box-shadow:0 4px 10px rgba(0,0,0,0.1);
}

.lc-chat-input input{
  flex:1;
  border:none;
  outline:none;
  margin:0 10px;
  font-size:13px;
}

.lc-chat-send img {
    width: 20px;
}

.lc-chat-send{
  width:36px;height:36px;
  border-radius:50%;
  background:#2E7D4F;
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  padding: 20px;
}

.lc-chat-form{
  padding:16px;
}

.lc-chat-label{
  font-size:13px;
  margin-bottom:8px;
}

.lc-chat-field{
  width:100%;
  padding:10px;
  border:1px solid #ccc;
  border-radius:6px;
}

.lc-chat-save{
  margin-top:12px;
  text-align:right;
}

.lc-chat-save button{
  background:#2E7D4F;
  color:#fff;
  border:none;
  padding:8px 16px;
  border-radius:20px;
}

/* PANEL */
.lc-chat-panel{
  background:#EFE7FA;
  height:-webkit-fill-available;
  border-top-left-radius:24px;
  border-top-right-radius:24px;
  padding:16px;
  overflow-y: auto;
  height: 61%;
}

.lc-chat-toggle img {
    width: 30px;
  filter: brightness(0) invert(1);
}

/* TOOLTIP */
.lc-chat-tooltip{
  position:absolute;
  bottom:70px; /* above icon */
  right:0;
  background:#2E7D4F;
  color:#fff;
  font-size:12px;
  padding:8px 12px;
  border-radius:8px;
  white-space:nowrap;}

/* Tooltip Arrow */
.lc-chat-tooltip::after{
  content:"";
  position:absolute;
  bottom:-5px;
  right:20px;
  width:10px;
  height:10px;
  background:#2E7D4F;
  transform:rotate(45deg);
}

/* SHOW ON HOVER */
.lc-chat-toggle:hover .lc-chat-tooltip{
  opacity:1;
  transform:translateY(0);
}

.lc-chat-panel-title{
  text-align:center;
  font-size:13px;
  color:#2E7D4F;
  margin-bottom:10px;
}

.lc-chat-panel-item{
  display:flex;
  align-items:center;
  padding:10px 0;
  border-bottom:1px solid #CFC3E6;
}

.lc-chat-panel-btn{
  margin-left:auto;
  background:#2E7D4F;
  color:#fff;
  font-size:10px;
  padding:4px 8px;
  border-radius:8px;
}
  
