/* Loader css start */
.fullscreen-loader {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #ffffff 0%, #f5f5f5 100%);
    display: flex;
