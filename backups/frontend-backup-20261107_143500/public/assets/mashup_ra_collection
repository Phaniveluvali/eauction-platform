.loader-logo {
    width: 100px;
    height: auto;
    opacity: 0;
    animation: fadeInOut 2s infinite ease-in-out;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.1));
    margin-bottom: 30px;
}

@keyframes fadeInOut {
    0% {
        opacity: 0;
        transform: scale(0.95);
    }

    50% {
        opacity: 1;
        transform: scale(1.08);
    }

    100% {
        opacity: 0;
        transform: scale(0.95);
    }
}

.dots-loader {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
}

.dots-loader div {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #D32437;
    animation: pulse 0.6s infinite ease-in-out alternate;
}

.dots-loader div:nth-child(2) {
    animation-delay: 0.2s;
}

.dots-loader div:nth-child(3) {
    animation-delay: 0.4s;
}

@keyframes pulse {
    from {
        transform: scale(1);
        opacity: 0.5;
    }

    to {
        transform: scale(1.6);
        opacity: 1;
    }
}


@media (max-width: 480px) {
    .loader-logo {
        width: 70px;
        margin-bottom: 20px;
    }

    .dots-loader div {
        width: 10px;
        height: 10px;
